{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Odoo 17",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}\\venv\\Scripts\\python.exe",
            "program": "${workspaceFolder}\\odoo\\odoo-bin",
            "args": ["-c", "${workspaceFolder}\\odoo.conf", "--dev=xml"],
            "preLaunchTask": "Start database",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Odoo 17 (upgrade estate module)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}\\venv\\Scripts\\python.exe",
            "program": "${workspaceFolder}\\odoo\\odoo-bin",
            "args": ["-c", "${workspaceFolder}\\odoo.conf", "--dev=xml", "-u", "estate"],
            "preLaunchTask": "Start database",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
